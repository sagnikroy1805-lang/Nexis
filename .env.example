# Copy to .env (gitignored) or set in your shell. Local development values only.

# PostgreSQL started by `make db-up` (Docker, postgres:16). Omit to use SQLite at data/nexis.db.
NEXIS_DATABASE_URL=postgresql+psycopg://nexis:nexis@localhost:5432/nexis

# Investigator: auto (LLM, falling back to a template) | llm | template
NEXIS_INVESTIGATOR=auto
NEXIS_INVESTIGATOR_MODEL=claude-opus-5-5

# Anthropic credentials are NOT stored here. Either run `ant auth login`, or set
# ANTHROPIC_API_KEY in your user environment (see README, "Investigator").

# Force XGBoost onto the CPU while a GNN run holds the GPU.
# NEXIS_XGB_DEVICE=cpu
